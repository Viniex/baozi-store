  "item": [
    {
      "name": "1 - Criar (POST)",
      "description": "Cria cliente, produto e pedido da situação fictícia. Execute nesta ordem.",
      "item": [
        {
          "name": "1.1 POST Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "description": "Cadastra o cliente (nome = Nome+RU).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeCliente}}\",\n  \"clienteDesde\": \"{{clienteDesde}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Tempo de resposta < 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test(\"Content-Type é JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const j = pm.response.json();",
                  "pm.test(\"Retornou id numérico\", () => pm.expect(j.id).to.be.a(\"number\"));",
                  "pm.test(\"Nome do cliente confere\", () => pm.expect(j.nome).to.eql(pm.collectionVariables.get(\"nomeCliente\")));",
                  "pm.test(\"clienteDesde confere\", () => pm.expect(j.clienteDesde).to.eql(pm.collectionVariables.get(\"clienteDesde\")));",
                  "pm.collectionVariables.set(\"clienteId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 POST Produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            },
            "description": "Cadastra o produto vendido pela loja.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeProduto}}\",\n  \"preco\": {{precoProduto}},\n  \"estoque\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Tempo de resposta < 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test(\"Content-Type é JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const j = pm.response.json();",
                  "pm.test(\"Retornou id numérico\", () => pm.expect(j.id).to.be.a(\"number\"));",
                  "pm.test(\"Nome do produto confere\", () => pm.expect(j.nome).to.eql(pm.collectionVariables.get(\"nomeProduto\")));",
                  "pm.test(\"Preço confere\", () => pm.expect(Number(j.preco)).to.eql(Number(pm.collectionVariables.get(\"precoProduto\"))));",
                  "pm.test(\"Produto em estoque (true)\", () => pm.expect(j.estoque).to.eql(true));",
                  "pm.collectionVariables.set(\"produtoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 POST Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "Registra o pedido ligando o cliente e o produto criados acima.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": {{quantidade}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Tempo de resposta < 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test(\"Content-Type é JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const j = pm.response.json();",
                  "pm.test(\"Retornou id numérico\", () => pm.expect(j.id).to.be.a(\"number\"));",
                  "pm.test(\"clienteId confere\", () => pm.expect(j.clienteId).to.eql(Number(pm.collectionVariables.get(\"clienteId\"))));",
                  "pm.test(\"produtoId confere\", () => pm.expect(j.produtoId).to.eql(Number(pm.collectionVariables.get(\"produtoId\"))));",
                  "pm.test(\"Quantidade confere\", () => pm.expect(j.quantidade).to.eql(Number(pm.collectionVariables.get(\"quantidade\"))));",
                  "pm.test(\"Cliente do pedido: nome confere\", () => pm.expect(j.cliente.nome).to.eql(pm.collectionVariables.get(\"nomeCliente\")));",
                  "pm.test(\"Produto do pedido: nome confere\", () => pm.expect(j.produto.nome).to.eql(pm.collectionVariables.get(\"nomeProduto\")));",
                  "pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "nomeCliente",
      "value": "Vinícius5474751"
    },
    {
      "key": "clienteDesde",
      "value": "2026-10-06"
    },
    {
      "key": "nomeProduto",
      "value": "Baozi Tradicional"
    },
    {
      "key": "precoProduto",
      "value": "8.50"
    },
    {
      "key": "quantidade",
      "value": "6"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
